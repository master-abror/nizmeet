# Contoh konfigurasi dev infra lokal. Salin menjadi deploy/.env (tidak ter-commit).
# `make dev-up` membuat deploy/.env otomatis dengan password acak bila belum ada.
# Hanya variabel yang dibutuhkan docker-compose.yml; variabel server/provider
# ditambahkan di milestone yang memakainya.
POSTGRES_USER=nizmeet
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_LOKAL
POSTGRES_DB=nizmeet
# Ubah bila port bentrok dengan kontainer lain (mis. pg18 manual di 5432).
POSTGRES_PORT=5432
REDIS_PORT=6379
